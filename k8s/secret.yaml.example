# Copy to secret.yaml and fill in real values. DO NOT commit secret.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: n8n-webhook-gateway-secrets
  namespace: platformbot
  labels:
    app: n8n-webhook-gateway
type: Opaque
stringData:
  DATABASE_URL: "sqlite+aiosqlite:///./gateway.db"
  SECRET_KEY: "CHANGE-ME-TO-RANDOM-SECRET"
  ENCRYPTION_KEY: "CHANGE-ME-TO-DIFFERENT-RANDOM-SECRET"
  LEGACY_ENCRYPTION_KEYS: ""
  ALLOW_WEAK_SECRETS: "false"
  ADMIN_USERNAME: "admin"
  ADMIN_PASSWORD: "CHANGE-ME"
  PUBLIC_BASE_URL: "https://n8n-webhook-gateway.platformbot.snag.eks.aws.theiconic.com.au"
  FORCE_HTTPS_COOKIES: "true"
  TRUSTED_PROXY_DEPTH: "1"
  WEBHOOK_RATE_LIMIT_PER_MIN: "200"
  WEBHOOK_MAX_BODY_BYTES: "1048576"
  ALLOWED_INTERNAL_HOSTS: ""
  BLOCK_PRIVATE_DESTINATION_IPS: "true"
  SECURITY_HEADERS_ENABLED: "true"
