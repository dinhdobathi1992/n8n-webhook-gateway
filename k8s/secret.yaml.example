# Copy to secret.yaml and fill in real values. DO NOT commit secret.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: n8n-webhook-gateway-secrets
  namespace: platformbot
  labels:
    app: n8n-webhook-gateway
type: Opaque
stringData:
  DATABASE_URL: "sqlite+aiosqlite:///./gateway.db"
  SECRET_KEY: "CHANGE-ME-TO-RANDOM-SECRET"
  ADMIN_USERNAME: "admin"
  ADMIN_PASSWORD: "CHANGE-ME"
  PUBLIC_BASE_URL: "https://n8n-webhook-gateway.platformbot.snag.eks.aws.theiconic.com.au"
