# HTTP listen port.
PORT=3000

# SQLAlchemy async DB URL. Local default stores SQLite beside the app.
DATABASE_URL=sqlite+aiosqlite:///./gateway.db

# JWT signing key for admin sessions. Use a unique random 32+ char value in prod.
SECRET_KEY=change-me-to-random-secret

# Fernet field-encryption key for stored webhook/auth secrets. Must differ from SECRET_KEY in prod.
ENCRYPTION_KEY=

# Comma-separated old encryption keys used only to decrypt existing rows during key rotation.
LEGACY_ENCRYPTION_KEYS=

# Local-dev escape hatch for weak/default secrets. Set false in prod.
ALLOW_WEAK_SECRETS=true

# First admin user seeded when the users table is empty.
ADMIN_USERNAME=admin

# First admin password seeded when the users table is empty. Change in prod.
ADMIN_PASSWORD=admin

# External base URL used for displayed webhook URLs, CORS origin, and Google Chat JWT audience.
PUBLIC_BASE_URL=http://localhost:3000

# Adds Secure to session cookies. Keep true in prod HTTPS; false only for local HTTP.
FORCE_HTTPS_COOKIES=false

# Number of trusted reverse proxies for X-Forwarded-For client IP parsing. Usually 1 behind ingress.
TRUSTED_PROXY_DEPTH=0

# Per-forward attempt timeout in seconds.
FORWARD_TIMEOUT_SECONDS=30

# Max forwarding attempts for 5xx/timeouts.
FORWARD_MAX_RETRIES=3

# Exponential backoff base delay in seconds between retries.
FORWARD_RETRY_BASE_SECONDS=1

# Per route/client inbound webhook requests per minute. Set 0 to disable.
WEBHOOK_RATE_LIMIT_PER_MIN=200

# Max inbound webhook body size in bytes. Set 0 to disable.
WEBHOOK_MAX_BODY_BYTES=1048576

# Comma-separated hostnames/patterns allowed to resolve to private IPs, e.g. n8n.internal,*.svc.cluster.local.
ALLOWED_INTERNAL_HOSTS=

# Blocks destination URLs resolving to private/internal IPs unless host is allowlisted.
BLOCK_PRIVATE_DESTINATION_IPS=true

# Adds common browser security headers.
SECURITY_HEADERS_ENABLED=true
